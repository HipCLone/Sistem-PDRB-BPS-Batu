{
  "name": "pdrb-kota-batu-local",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite --host 127.0.0.1",
    "dev:server": "node --watch backend/server.js",
    "build": "vite build",
    "start": "node backend/server.js",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test scripts/excel-presentation.test.mjs scripts/api.test.mjs",
    "audit:excel": "node scripts/audit-excel.mjs --report",
    "test:tables": "node scripts/check-table-render.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "vite": "^7.1.7"
  }
}
